<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedCode="false"
    resolveFromConfigFile="true"
>
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>

    <!-- PhpRedisMaintenanceClient types against \Redis; the bundled stub lets
         psalm analyze it without ext-redis being installed. -->
    <enableExtensions>
        <extension name="redis"/>
    </enableExtensions>
    <issueHandlers>
        <MixedAssignment errorLevel="suppress"/>
        <MixedArrayAccess errorLevel="suppress"/>
        <MixedArgument errorLevel="suppress"/>
    </issueHandlers>
</psalm>
